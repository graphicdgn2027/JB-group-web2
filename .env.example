# Copy this file to `.env` and fill in your Supabase project's values.
# `.env` is git-ignored — never commit real keys.
#
# Where to find these:
#   Supabase Dashboard → Project Settings → Data API → Project URL
#   Supabase Dashboard → Project Settings → API Keys → anon / public
#
# The anon key is safe to expose in the browser: row-level security in
# supabase/schema.sql is what actually restricts writes to signed-in users.
#
# On Vercel, add these same two variables under
#   Project → Settings → Environment Variables
# and redeploy (Vite inlines VITE_* vars at build time).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Only needed for `npm run setup:supabase` (never used by the website) ---
# Personal access token: https://supabase.com/dashboard/account/tokens
# Revoke it after setup if you don't need it again.
SUPABASE_ACCESS_TOKEN=
# Optional: the Super Admin login to create. Defaults to the email in supabase/schema.sql.
SUPER_ADMIN_EMAIL=
# Optional: its password. If empty, a strong one is generated and printed once.
SUPER_ADMIN_PASSWORD=

# Public site URL, used for canonical/social tags, robots.txt and sitemap.xml.
# Set this on the host (e.g. Vercel) to the real domain, no trailing slash.
VITE_SITE_URL=https://your-domain.com
