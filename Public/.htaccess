# JB Group website — Apache config for shared/cPanel hosting.
# Vercel gets this same routing behaviour from vercel.json's rewrite rule;
# this file does the equivalent job for a plain Apache host.

# Security headers. The CSP is the control that bounds an injected-script bug:
# content is editable from the dashboard, so a bad value must not be able to
# load or run code. 'unsafe-inline' for styles is required because the app sets
# inline styles; scripts get no such exemption.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.web3forms.com; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # HSTS: only meaningful once the site is served over HTTPS everywhere.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Serve compressed text assets when the client supports it.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache hashed, versioned assets aggressively; never cache the HTML shell,
# so a new deploy is picked up immediately instead of showing a stale build.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Uncomment once an SSL certificate is active on this domain (cPanel's
# AutoSSL / Let's Encrypt issues one for free — check SSL/TLS Status first).
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Single-page app routing: this is a client-side-routed React app, so any
# URL that isn't a real file or folder (e.g. /about, /portfolio/hipco-trading)
# must still be served index.html and let React Router take over. Without
# this, refreshing or directly opening any page but "/" would 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Custom 404s are handled inside the app (see NotFoundPage.tsx); anything
# that reaches Apache's own 404 falls back to the same SPA shell.
ErrorDocument 404 /index.html
